            <layer-tree-layer id="LAGE_TXT_ALKIS_MIN_c247c52a_ac17_4946_a81b_71837de1c0cf" legend_exp="" name="LAGE_TXT_ALKIS_MIN" checked="Qt::Checked" patch_size="-1,-1" legend_split_behavior="0" providerKey="postgres" source="dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='ogc_fid' estimatedmetadata=true srid=25833 type=MultiPoint checkPrimaryKeyUnicity='0' table=&quot;(SELECT ogc_fid,layer,CASE WHEN grad_pt&lt;0 THEN abs(s.grad_pt) ELSE 0.25*coalesce(skalierung,1)*s.grad_pt*1.3225 END AS tsize,CASE WHEN grad_pt&lt;0 THEN 'Point' ELSE 'MapUnit' END AS tunit,text,CASE coalesce(po_labels.horizontaleausrichtung,s.horizontaleausrichtung) WHEN 'linksbündig' THEN 'Left' WHEN 'rechtsbündig' THEN 'Right' ELSE 'Center' END AS halign,CASE coalesce(po_labels.vertikaleausrichtung,s.vertikaleausrichtung) WHEN 'oben' THEN 'Cap' WHEN 'Basis' THEN 'Base' ELSE 'Half' END AS valign,coalesce(s.art,'Arial'::text) AS family,CASE WHEN s.stil LIKE '%Kursiv%' THEN 1 ELSE 0 END AS italic,CASE WHEN s.stil LIKE '%Fett%' THEN 1 ELSE 0 END AS bold,coalesce(sperrung_pt*0.25,0) AS fontsperrung,replace(f.umn,' ',',') AS tcolor,CASE WHEN grad_pt&lt;0 THEN 0 ELSE 1 END AS tshow,point,st_x(point) AS tx,st_y(point) AS ty,drehwinkel_grad AS tangle FROM \&quot;alkis_zvg_tables\&quot;.po_labels LEFT OUTER JOIN \&quot;alkis_zvg_tables\&quot;.alkis_schriften s ON po_labels.signaturnummer=s.signaturnummer AND s.katalog=1 LEFT OUTER JOIN \&quot;alkis_zvg_tables\&quot;.alkis_farben f ON s.farbe=f.id WHERE thema='Lagebezeichnungen' AND modell &amp;&amp; ARRAY['DLKM','DKKM1000']::varchar[])&quot; (point) sql=1=1" expanded="1">
              <customproperties>
                <Option/>
              </customproperties>
            </layer-tree-layer>
          </layer-tree-group>
        </layer-tree-group>
