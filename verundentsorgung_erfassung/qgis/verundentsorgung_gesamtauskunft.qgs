    </maplayer>
    <maplayer labelsEnabled="0" wkbType="Point" geometry="Point" maxScale="0" styleCategories="AllStyleCategories" refreshOnNotifyEnabled="0" hasScaleBasedVisibilityFlag="0" symbologyReferenceScale="-1" simplifyDrawingHints="1" type="vector" readOnly="0" autoRefreshMode="Disabled" minScale="100000000" simplifyMaxScale="1" autoRefreshTime="0" refreshOnNotifyMessage="" simplifyDrawingTol="1" legendPlaceholderImage="" simplifyAlgorithm="0" simplifyLocal="1">
      <id>aw_pkt_topologie_v_5d48b72b_c87e_43cf_83f0_671578176374</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='id' srid=25833 type=Point checkPrimaryKeyUnicity='1' table="verundentsorgung"."aw_pkt_topologie_v" (geometry) sql=
                exists (
                    select 'X'
                    from verundentsorgung.st_vw_projekt p
                    where p.id = id_st_vw_projekt and p.kurztext = 'ZVG'
                )
                and id_st_strasse in (
                    select s.id_st_strasse
                    from verundentsorgung.strassenschluessel_v s,
                    verundentsorgung.st_vw_projektfilter pf
                    where s.id_st_vw_projekt = pf.id_st_vw_projekt
                    and ( ( position(s.amt in pf.langtext) > 0
                            and pf.kurztext = 'ZVG Projekte Amt Schönberger Land'
                          )
                          or s.amt = 'unbekannt'
                        )
                )
                and 1 = 1
                </datasource>
      <keywordList>
        <value></value>
      </keywordList>
      <layername>aw_pkt_topologie_v</layername>
