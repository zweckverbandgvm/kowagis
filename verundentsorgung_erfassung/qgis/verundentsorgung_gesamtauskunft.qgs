      <editform tolerant="1"></editform>
      <editforminit>my_form_open</editforminit>
      <editforminitcodesource>2</editforminitcodesource>
      <editforminitfilepath></editforminitfilepath>
      <editforminitcode><![CDATA[# -*- coding: utf-8 -*-
"""
QGIS-Formulare können eine Python-Funktion haben,, die aufgerufen wird, wenn sich das Formular öffnet

Diese Funktion kann verwendet werden um dem Formular Extralogik hinzuzufügen.

Der Name der Funktion wird im Feld "Python Init-Function" angegeben
Ein Beispiel folgt:
"""
from qgis.PyQt.QtWidgets import QPushButton, QDialog,QLineEdit,QComboBox,QTextEdit,QWidget

def my_form_open(dialog, layer, feature):
    context = QgsExpressionContext()

    
    darstellung = dialog.findChild(QLineEdit , "Darstellung")
    name_number = dialog.findChild(QLineEdit , "name_number")
    kabel_widget = dialog.findChild(QComboBox, "id_st_vw_kabeltyp")
    dimension_widget = dialog.findChild(QComboBox, "id_st_vw_dimension")

    
    def update_Darstellung():
        kabel_text = kabel_widget.currentText()
        name_text = name_number.text()
        dimension_text = dimension_widget.currentText()
        
        teil_1 = ''
        if kabel_text != 'unbekannt':
            teil_1 =  kabel_text + ', '
            
        teil_2 = ''
        if dimension_text != 'unbekannt':
            teil_2 = dimension_text
            
        if darstellung:
            darstellung.setText(f"{name_text}-{teil_1}{teil_2}")
            
            
    if name_number:
        name_number.textChanged.connect(update_Darstellung)
    if kabel_widget:
        kabel_widget.currentIndexChanged.connect(update_Darstellung)
    if dimension_widget:
        dimension_widget.currentIndexChanged.connect(update_Darstellung)    

        
    
    update_Darstellung()          
]]></editforminitcode>
