      <id>ta_fla_anlagenflaechen_1c886d7c_b503_4ad5_b947_e380fb0f2822</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 sslmode=disable authcfg=verent1 key='id' srid=25833 type=Polygon checkPrimaryKeyUnicity='0' table="verundentsorgung"."aw_fla_umlageflaeche" (geometry) sql=
                exists (
                    select 'X'
                    from verundentsorgung.st_vw_projekt p
                    where p.id = id_st_vw_projekt and p.kurztext = 'ZVG'
                )
                and id_st_strasse in (
                    select s.id_st_strasse
                    from verundentsorgung.strassenschluessel_v s,
                    verundentsorgung.st_vw_projektfilter pf
                    where s.id_st_vw_projekt = pf.id_st_vw_projekt
                    and ( ( position(s.amt in pf.langtext) > 0
                            and pf.kurztext = 'ZVG Projekte Amt Schönberger Land'
                          )
                          or s.amt = 'unbekannt'
                        )
                )
                and 1 = 1
                </datasource>
      <keywordList>
        <value></value>
      </keywordList>
