            <editforminitcode><![CDATA[from qgis.PyQt.QtWidgets import QPushButton, QDialog,QLineEdit,QComboBox
from qgis.core import QgsProject
import time

start_time = time.time()



def my_form_open(dialog, layer, feature):
    context = QgsExpressionContext()
    
    def get_sohlhohe(id_knoten,knoten_pos):
        
        LAYER_WHITELIST = ["Schacht", "Abscheider","Auslauf","Dueker","Einleitungsstellen","Pumpwerk","Klaertank","Klaeranlage", "Loeschwasserentnahmestelle","Schachtdeckel","Schieber","sonstige_Anlage","Spuehlhydrant","Verbindungen",  "Haltungen"]
        
        
        if not id_knoten:
        # Nothing to do if id is NULL / empty
            return

        # Check if it's the "all zeros" UUID
        if str(id_knoten) == "'00000000-0000-0000-0000-000000000000'::uuid":
            return
       
        attribute_name = "sohlhoehe"
        attribute_name_2 = "rsa"

        for layer in QgsProject.instance().mapLayers().values():
            if not layer.isValid():
                continue
                
            if layer.name() not in LAYER_WHITELIST:
                continue    
                

            if layer.type() == layer.VectorLayer:
                # build expression filter
                expr = f'"id" = \'{id_knoten}\''
                for feature in layer.getFeatures(expr):


                    if attribute_name in feature.fields().names():
                        value = feature[attribute_name]
                        print(f"Layer: {layer.name()}, ID={id_knoten}, {attribute_name}={value}")

                    # Fallback to "rsa" only if "sohlhoehe" does not exist
                    elif attribute_name_2 in feature.fields().names():
                        value = feature[attribute_name_2]
                        print(f"Layer: {layer.name()}, ID={id_knoten}, {attribute_name_2}={value}")

                    else:
                        continue

                    # Update UI
                    if knoten_pos == 'oben':
                        sohle_ablaufschacht = dialog.findChild(QLineEdit, "sohle_ablaufschacht")
                        if sohle_ablaufschacht:
                            sohle_ablaufschacht.setText(str(value))
                            if 'deckelhoehe' in feature.fields().names():
                                value = feature['deckelhoehe']
                                deckelhoehe_start = dialog.findChild(QLineEdit, "deckelhoehe_start")                
                                deckelhoehe_start.setText(str(value))
                            else:                                 
                                deckelhoehe_start = dialog.findChild(QLineEdit, "deckelhoehe_start")                
                                deckelhoehe_start.setText('')
                    elif knoten_pos == 'unten':
                        sohle_einlaufschacht = dialog.findChild(QLineEdit, "sohle_einlaufschacht")
                        if sohle_einlaufschacht:
                            sohle_einlaufschacht.setText(str(value))  
                            if 'deckelhoehe' in feature.fields().names():
                                value = feature['deckelhoehe']
                                deckelhoehe_ende = dialog.findChild(QLineEdit, "deckelhoehe_ende")
                                deckelhoehe_ende.setText(str(value))
                            else:
                                deckelhoehe_ende = dialog.findChild(QLineEdit, "deckelhoehe_ende")
                                deckelhoehe_ende.setText('')
    
    #print(dialog.findChild(QPushButton, "button_action"))

    # Button aus dem UI holen (Name im .ui muss "button_action" sein)
    button = dialog.findChild(QPushButton, "button_action")
    button_2 = dialog.findChild(QPushButton, "button_action_2")
    button_save_close = dialog.findChild(QPushButton, "button_save_close")
    button_cancel_close = dialog.findChild(QPushButton, "button_cancel_close")
    button_oben  = dialog.findChild(QPushButton, "start")
    button_unten = dialog.findChild(QPushButton, "ende")
    
    line_edit = dialog.findChild(QLineEdit, "lineEdit")
    laenge_widget = dialog.findChild(QLineEdit, "laenge")
    nennweite_widget = dialog.findChild(QLineEdit, "nennweite")
    material_widget = dialog.findChild(QComboBox, "id_st_vw_material")
    haltungsgefaelle_widget = dialog.findChild(QLineEdit, "haltungsgefaelle")
    oben_field = "id_knoten_oben"
    unten_field = "id_knoten_unten"

    if oben_field in feature.fields().names():
        oben_id = feature[oben_field]
        if oben_id not in (None, ""):
            start = time.time()
            get_sohlhohe(oben_id, "oben")
            end = time.time()
            print("Duration:", end - start, "seconds")

    if unten_field in feature.fields().names():
        unten_id = feature[unten_field]
        if unten_id not in (None, ""):
            start = time.time()
            get_sohlhohe(unten_id, "unten")
            end = time.time()
            print("Duration:", end - start, "seconds")            
            


    
    

    if button:
        def run_action():
            print("Button wurde gedrückt")
            # gewünschte Aktion suchen
            for act in layer.actions().actions():
                if act.name() == "Dokumente Ansehen":
                    layer.actions().doAction(act.id(), feature, context)
                    break

        button.clicked.connect(run_action)

    if button_2:
        def run_action():
            print("Button_2 wurde gedrückt")
            # gewünschte Aktion suchen
            for act in layer.actions().actions():
                if act.name() == "Dokument Hinzufügen":
                    layer.actions().doAction(act.id(), feature, context)
                    break

        button_2.clicked.connect(run_action)
        
        
    if button_oben:
        def run_action():
            print("Button wurde gedrückt")
            # gewünschte Aktion suchen
            for act in layer.actions().actions():
                if act.name() == "Knoten Oben":
                    layer.actions().doAction(act.id(), feature, context)
                    break

        button_oben.clicked.connect(run_action)        
        
    if button_unten:
        def run_action():
            print("Button wurde gedrückt")
            # gewünschte Aktion suchen
            for act in layer.actions().actions():
                if act.name() == "Knoten Unten":
                    layer.actions().doAction(act.id(), feature, context)
                    break

        button_unten.clicked.connect(run_action)        
        
        
    if button_save_close:
        def save_and_close():
            print("Speichern & Schließen")
            # Eltern-Dialog holen und schließen wie "OK"
            parent = dialog.parent()
            while parent and not isinstance(parent, QDialog):
                parent = parent.parent()
            if parent:
                parent.accept()   # Speichern + schließen
            else:
                print("Kein QDialog gefunden")
        
        button_save_close.clicked.connect(save_and_close)
    
    if button_cancel_close:
        def cancel_and_close():
            print("Abbrechen & Schließen (ohne Speichern)")
            parent = dialog.parent()
            while parent and not isinstance(parent, QDialog):
                parent = parent.parent()
            if parent:
                parent.reject()   # Schließen ohne speichern
        button_cancel_close.clicked.connect(cancel_and_close)
        
        
    def update_line_edit():
        laenge = laenge_widget.text() if laenge_widget else ""
        nennweite = nennweite_widget.text() if nennweite_widget else ""
        material = material_widget.currentText() if material_widget else ""
        haltungsgefaelle = haltungsgefaelle_widget.text() if haltungsgefaelle_widget else ""
        if line_edit:
            line_edit.setText(f"{laenge}m {haltungsgefaelle}‰ {material} DN {nennweite}")
            
            

    # Signale verbinden
    if laenge_widget:
        laenge_widget.textChanged.connect(update_line_edit)
    if nennweite_widget:
        nennweite_widget.textChanged.connect(update_line_edit)
    if haltungsgefaelle_widget:
        haltungsgefaelle_widget.textChanged.connect(update_line_edit)
    if material_widget:
        material_widget.currentIndexChanged.connect(update_line_edit)
    
    update_line_edit()    

        
        ]]></editforminitcode>
