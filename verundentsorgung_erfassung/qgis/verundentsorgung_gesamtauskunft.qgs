    <ExpressionFunctions>
      <pythonCode type="QString">from qgis.core import *
from qgis.gui import *

@qgsfunction(group='Custom', referenced_columns=[])&#xd;
def sichtbar(objekt_id, layer_str):&#xd;
    layername = layer_str[7:30].capitalize()&#xd;
    layers = QgsProject.instance().mapLayersByName(layername)&#xd;
    if not layers:&#xd;
        return 0&#xd;
&#xd;
    root = QgsProject.instance().layerTreeRoot()&#xd;
&#xd;
    for layer in layers:&#xd;
        node = root.findLayer(layer.id())&#xd;
&#xd;
        # skip invisible layers&#xd;
        if not node or not node.isVisible():&#xd;
            continue&#xd;
&#xd;
        # check if the object exists in this visible layer&#xd;
        expr = f'"id" = \'{objekt_id}\''&#xd;
        request = QgsFeatureRequest().setFilterExpression(expr)&#xd;
        feature = next(layer.getFeatures(request), None)&#xd;
&#xd;
        if feature:&#xd;
            return 1   # found in a visible layer&#xd;
&#xd;
    return 0&#xd;
    &#xd;
@qgsfunction(group='Custom', referenced_columns=[])&#xd;
def sichtbar_haltung(objekt_id):&#xd;
    layers = QgsProject.instance().mapLayersByName('Haltung')&#xd;
    if not layers:&#xd;
        return 0&#xd;
&#xd;
&#xd;
    layer = layers[0]&#xd;
    &#xd;
    node = QgsProject.instance().layerTreeRoot().findLayer(layer.id())&#xd;
&#xd;
    if node and node.isVisible():        &#xd;
    &#xd;
        expr = f'"id" = \'{objekt_id}\''&#xd;
        request = QgsFeatureRequest().setFilterExpression(expr)&#xd;
&#xd;
        # Get first feature efficiently&#xd;
        feature = next(layer.getFeatures(request), None)&#xd;
        if feature:&#xd;
            return 1&#xd;
    return 0    </pythonCode>
    </ExpressionFunctions>
