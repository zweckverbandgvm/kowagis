        <actionsetting id="{ad962211-397b-475d-8db2-556f0216a3b0}" notificationMessage="" name="Dokument Hinzufügen" action="from qgis.utils import iface&#xd;&#xa;from qgis.core import QgsApplication, QgsAuthMethodConfig, Qgis&#xd;&#xa;from qgis.gui import QgsMapToolEmitPoint&#xd;&#xa;from PyQt5.QtWidgets import QDialog, QVBoxLayout, QLabel, QComboBox, QPushButton&#xd;&#xa;from qgis.PyQt.QtCore import Qt&#xd;&#xa;#import psycopg2&#xd;&#xa;#print('test')&#xd;&#xa;#print([%@id%])&#xd;&#xa;layer = QgsProject.instance().mapLayersByName(&quot;st_dokument&quot;)[0]&#xd;&#xa;&#xd;&#xa;# Make sure the layer is editable&#xd;&#xa;if not layer.isEditable():&#xd;&#xa;    layer.startEditing()&#xd;&#xa;&#xd;&#xa;# Create a new feature    &#xd;&#xa;feature = QgsFeature(layer.fields())&#xd;&#xa;&#xd;&#xa;# Apply layer-defined default values&#xd;&#xa;for idx in range(len(layer.fields())):&#xd;&#xa;    default_value = layer.defaultValue(idx)&#xd;&#xa;    feature.setAttribute(idx, default_value)&#xd;&#xa;&#xd;&#xa;feature.setAttribute(&quot;id_objekt&quot;, &quot;[%id%]&quot;)&#xd;&#xa;&#xd;&#xa;form = QgsAttributeDialog(layer, feature, False)  # False = not for editing an existing feature&#xd;&#xa;#form.setAttribute(Qt.WA_DeleteOnClose)&#xd;&#xa;&#xd;&#xa;if form.exec_():&#xd;&#xa;    updated_feature = form.feature()  # ✅ get user's edited data&#xd;&#xa;    if layer.addFeature(updated_feature):&#xd;&#xa;        layer.commitChanges()&#xd;&#xa;        layer.triggerRepaint()&#xd;&#xa;        print(&quot;✔️ Feature added and saved.&quot;)&#xd;&#xa;    else:&#xd;&#xa;        print(&quot;❌ Failed to add feature.&quot;)&#xd;&#xa;        layer.rollBack()&#xd;&#xa;else:&#xd;&#xa;    print(&quot;⚠️ User canceled the form.&quot;)&#xd;&#xa;    layer.rollBack()" type="1" capture="0" isEnabledOnlyWhenEditable="1" shortTitle="" icon="">
          <actionScope id="Layer"/>
        </actionsetting>
        <actionsetting id="{5a46e678-2295-4370-b575-db4fb44e352e}" notificationMessage="" name="Dokumente Ansehen" action="from qgis.utils import iface&#xd;&#xa;from qgis.core import QgsApplication, QgsAuthMethodConfig, Qgis&#xd;&#xa;from qgis.gui import QgsMapToolEmitPoint&#xd;&#xa;from PyQt5.QtWidgets import QDialog, QVBoxLayout, QLabel, QComboBox, QPushButton&#xd;&#xa;from qgis.PyQt.QtCore import Qt&#xd;&#xa;layer = QgsProject.instance().mapLayersByName(&quot;st_dokument&quot;)[0]&#xd;&#xa;&#xd;&#xa;# Filter setzen: nur Zeilen mit Kurztext = 'Haltung'&#xd;&#xa;layer.setSubsetString(&quot;\&quot;id_objekt\&quot; = '[%id%]'&quot;)&#xd;&#xa;#layer.selectByExpression(&quot;\&quot;id_objekt\&quot; = '[%id%]'&quot;)&#xd;&#xa;&#xd;&#xa;# Attributtabelle anzeigen&#xd;&#xa;iface.showAttributeTable(layer)" type="1" capture="0" isEnabledOnlyWhenEditable="0" shortTitle="" icon="">
          <actionScope id="Layer"/>
        </actionsetting>
        <actionsetting id="{f3493912-8a61-4cb0-b3ea-a271cec551eb}" notificationMessage="" name="Test2 waelt alleine den Objekttyp" action="from qgis.utils import iface&#xd;&#xa;from qgis.core import QgsProject, QgsFeature, QgsFeatureRequest, QgsExpression&#xd;&#xa;from qgis.gui import QgsAttributeDialog&#xd;&#xa;from PyQt5.QtCore import Qt&#xd;&#xa;import uuid&#xd;&#xa;&#xd;&#xa;# Step 1: Suche ID aus st_vw_objektbezeichnung mit Kurztext = 'Haltung'&#xd;&#xa;def finde_id_nach_kurztext(kurztext_suche):&#xd;&#xa;    layer = QgsProject.instance().mapLayersByName(&quot;st_vw_objektbezeichnung&quot;)[0]&#xd;&#xa;    feld_kurztext = &quot;langtext&quot;&#xd;&#xa;    feld_id = &quot;id&quot;&#xd;&#xa;    for feature in layer.getFeatures():&#xd;&#xa;        if feature[feld_kurztext] == kurztext_suche:&#xd;&#xa;            return feature[feld_id]&#xd;&#xa;    return None&#xd;&#xa;&#xd;&#xa;# ID für &quot;Haltung&quot; holen&#xd;&#xa;print(&quot;decode_uri(@layer, 'table')&quot;)&#xd;&#xa;id_objektbezeichnung = finde_id_nach_kurztext(&quot;[%decode_uri(@layer, 'table')%]&quot;)&#xd;&#xa;if not id_objektbezeichnung:&#xd;&#xa;    print(&quot;❌ Keine passende ID gefunden.&quot;)&#xd;&#xa;    raise Exception(&quot;Abbruch: Keine gültige ID gefunden.&quot;)&#xd;&#xa;&#xd;&#xa;# Step 2: Neuer Eintrag in st_dokument&#xd;&#xa;layer = QgsProject.instance().mapLayersByName(&quot;st_dokument&quot;)[0]&#xd;&#xa;&#xd;&#xa;# Layer editierbar machen&#xd;&#xa;if not layer.isEditable():&#xd;&#xa;    layer.startEditing()&#xd;&#xa;&#xd;&#xa;# Neues Feature mit Defaults&#xd;&#xa;feature = QgsFeature(layer.fields())&#xd;&#xa;for idx in range(len(layer.fields())):&#xd;&#xa;    default_value = layer.defaultValue(idx)&#xd;&#xa;    feature.setAttribute(idx, default_value)&#xd;&#xa;&#xd;&#xa;# Pflichtfelder setzen&#xd;&#xa;feature.setAttribute(&quot;id_objekt&quot;, &quot;[%id%]&quot;)&#xd;&#xa;feature.setAttribute(&quot;id_st_vw_objektbezeichnung&quot;, id_objektbezeichnung)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;# Formular anzeigen&#xd;&#xa;form = QgsAttributeDialog(layer, feature, False)&#xd;&#xa;&#xd;&#xa;if form.exec_():&#xd;&#xa;    updated_feature = form.feature()&#xd;&#xa;    if layer.addFeature(updated_feature):&#xd;&#xa;        layer.commitChanges()&#xd;&#xa;        layer.triggerRepaint()&#xd;&#xa;        print(&quot;✔️ Feature added and saved.&quot;)&#xd;&#xa;    else:&#xd;&#xa;        print(&quot;❌ Failed to add feature.&quot;)&#xd;&#xa;        layer.rollBack()&#xd;&#xa;else:&#xd;&#xa;    print(&quot;⚠️ User canceled the form.&quot;)&#xd;&#xa;    layer.rollBack()&#xd;&#xa;" type="1" capture="0" isEnabledOnlyWhenEditable="0" shortTitle="" icon="">
          <actionScope id="Layer"/>
        </actionsetting>
      </attributeactions>
