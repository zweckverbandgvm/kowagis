    <maplayer labelsEnabled="1" wkbType="MultiPoint" geometry="Point" maxScale="0" styleCategories="AllStyleCategories" refreshOnNotifyEnabled="0" hasScaleBasedVisibilityFlag="1" symbologyReferenceScale="-1" simplifyDrawingHints="0" type="vector" readOnly="1" autoRefreshMode="Disabled" minScale="5000" simplifyMaxScale="1" autoRefreshTime="0" refreshOnNotifyMessage="" simplifyDrawingTol="1" legendPlaceholderImage="" simplifyAlgorithm="0" simplifyLocal="1">
      <id>LAGE_TXT_ALKIS_MIN_c247c52a_ac17_4946_a81b_71837de1c0cf</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='ogc_fid' estimatedmetadata=true srid=25833 type=MultiPoint checkPrimaryKeyUnicity='0' table="(SELECT ogc_fid,layer,CASE WHEN grad_pt&lt;0 THEN abs(s.grad_pt) ELSE 0.25*coalesce(skalierung,1)*s.grad_pt*1.3225 END AS tsize,CASE WHEN grad_pt&lt;0 THEN 'Point' ELSE 'MapUnit' END AS tunit,text,CASE coalesce(po_labels.horizontaleausrichtung,s.horizontaleausrichtung) WHEN 'linksbündig' THEN 'Left' WHEN 'rechtsbündig' THEN 'Right' ELSE 'Center' END AS halign,CASE coalesce(po_labels.vertikaleausrichtung,s.vertikaleausrichtung) WHEN 'oben' THEN 'Cap' WHEN 'Basis' THEN 'Base' ELSE 'Half' END AS valign,coalesce(s.art,'Arial'::text) AS family,CASE WHEN s.stil LIKE '%Kursiv%' THEN 1 ELSE 0 END AS italic,CASE WHEN s.stil LIKE '%Fett%' THEN 1 ELSE 0 END AS bold,coalesce(sperrung_pt*0.25,0) AS fontsperrung,replace(f.umn,' ',',') AS tcolor,CASE WHEN grad_pt&lt;0 THEN 0 ELSE 1 END AS tshow,point,st_x(point) AS tx,st_y(point) AS ty,drehwinkel_grad AS tangle FROM \"alkis_zvg_tables\".po_labels LEFT OUTER JOIN \"alkis_zvg_tables\".alkis_schriften s ON po_labels.signaturnummer=s.signaturnummer AND s.katalog=1 LEFT OUTER JOIN \"alkis_zvg_tables\".alkis_farben f ON s.farbe=f.id WHERE thema='Lagebezeichnungen' AND modell &amp;&amp; ARRAY['DLKM','DKKM1000']::varchar[])" (point) sql=1=1</datasource>
