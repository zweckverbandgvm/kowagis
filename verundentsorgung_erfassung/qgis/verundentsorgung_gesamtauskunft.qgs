    <maplayer labelsEnabled="0" wkbType="Point" geometry="Point" maxScale="0" styleCategories="AllStyleCategories" refreshOnNotifyEnabled="0" hasScaleBasedVisibilityFlag="0" symbologyReferenceScale="-1" simplifyDrawingHints="0" type="vector" readOnly="0" autoRefreshMode="Disabled" minScale="100000000" simplifyMaxScale="1" autoRefreshTime="0" refreshOnNotifyMessage="" simplifyDrawingTol="2" legendPlaceholderImage="" simplifyAlgorithm="2" simplifyLocal="0">
      <id>wa_pkt_topologie_default_b1d73550_5ff7_4406_b8e8_44d7b24af3cd</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='id' srid=25833 type=Point checkPrimaryKeyUnicity='0' table="verundentsorgung"."wa_pkt_topologie_default" (geometry) sql=
                exists (
                    select 'X'
                    from verundentsorgung.st_vw_projekt p
                    where p.id = id_st_vw_projekt and p.kurztext = 'ZVG'
                )
                and id_st_strasse in (
                    select s.id_st_strasse
                    from verundentsorgung.strassenschluessel_v s,
                    verundentsorgung.st_vw_projektfilter pf
                    where s.id_st_vw_projekt = pf.id_st_vw_projekt
                    and ( ( position(s.amt in pf.langtext) > 0
                            and pf.kurztext = 'ZVG Projekte Amt Schönberger Land'
                          )
                          or s.amt = 'unbekannt'
                        )
                )
                and 1 = 1
                </datasource>
      <keywordList>
        <value></value>
      </keywordList>
      <layername>wa_pkt_topologie_default</layername>
