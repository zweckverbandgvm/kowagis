      <id>wa_lin_topologie_v_a5400874_f6f6_4297_b750_74b970470ad2</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='id' srid=25833 type=LineString checkPrimaryKeyUnicity='1' table="verundentsorgung"."wa_lin_topologie_v" (geometry) sql=
                exists (
                    select 'X'
                    from verundentsorgung.st_vw_projekt p
                    where p.id = id_st_vw_projekt and p.kurztext = 'ZVG'
                )
                and id_st_strasse in (
                    select s.id_st_strasse
                    from verundentsorgung.strassenschluessel_v s,
                    verundentsorgung.st_vw_projektfilter pf
                    where s.id_st_vw_projekt = pf.id_st_vw_projekt
                    and ( ( position(s.amt in pf.langtext) > 0
                            and pf.kurztext = 'ZVG Projekte Amt Schönberger Land'
                          )
                          or s.amt = 'unbekannt'
                        )
                )
                and 1 = 1
                </datasource>
      <keywordList>
        <value></value>
      </keywordList>
      <layername>wa_lin_topologie_v</layername>
