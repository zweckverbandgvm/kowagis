      <editforminitcodesource>2</editforminitcodesource>
      <editforminitfilepath></editforminitfilepath>
      <editforminitcode><![CDATA[# -*- coding: utf-8 -*-
from qgis.PyQt.QtWidgets import QPushButton, QDialog,QLineEdit,QComboBox,QTextEdit,QWidget
from qgis.core import QgsProject




def my_form_open(dialog, layer, feature):
    context = QgsExpressionContext()

    
    darstellung = dialog.findChild(QLineEdit , "darstellung")
    laenge_widget = dialog.findChild(QLineEdit , "laenge")
    nennweite_widget = dialog.findChild(QLineEdit , "nennweite")
    wandstaerke_widget = dialog.findChild(QLineEdit , "wandstaerke")
    material_widget = dialog.findChild(QComboBox, "id_st_vw_material")
    verlegetyp_widget = dialog.findChild(QComboBox, "id_st_vw_verlegetyp")
    aussendurchmesser_widget = dialog.findChild(QLineEdit , "aussendurchmesser")
    
    #print(darstellung.text())
    #print(laenge_widget.text())
    #print(nennweite_widget.text())
    #print(wandstaerke_widget.text())
    #print(aussendurchmesser_widget.text())
    #print(material_widget.currentText())
    #print(verlegetyp_widget.currentText())




    
    def update_Darstellung():
        material = material_widget.currentText()
        nennweite = nennweite_widget.text()
        aussendurchmesser = aussendurchmesser_widget.text()
        wandstaerke = wandstaerke_widget.text()
        verlegetyp = verlegetyp_widget.currentText()
        
        teil_1 = ''
        if material in ('AZ', 'GG', 'GGG', 'STAHL', 'ST', 'UNBEKANNT'):
            teil_1 =   material + ' ' + nennweite
            #print(teil_1)
        if material in ('PE', 'PE 100', 'PE 100 TS', 'PE 100 RC', 'PE 63', 'PE 80', 'PE-HD', 'PEX', 'PVC', 'KWK', 'ST'):
            teil_1 =  material 
            if aussendurchmesser != '':
                teil_1 += ' d ' + aussendurchmesser
            #print(teil_1)    
            
        teil_2 = ''
        if wandstaerke not in ('', '0',0):
            teil_2 = ' x ' + wandstaerke
        
        teil_3 = ''
        teil_3 = 'verlegetyp' if verlegetyp in ['Horizontalspülbohrung'] else ''
        
        if darstellung:
            darstellung.setText(f"{teil_1} {teil_2} {teil_3} ")
            
            
    if laenge_widget:
        laenge_widget.textChanged.connect(update_Darstellung)
    if nennweite_widget:
        nennweite_widget.textChanged.connect(update_Darstellung)
    if aussendurchmesser_widget:
        aussendurchmesser_widget.textChanged.connect(update_Darstellung)
    if material_widget:
        material_widget.currentIndexChanged.connect(update_Darstellung)
    if wandstaerke_widget:
        wandstaerke_widget.textChanged.connect(update_Darstellung)
    if verlegetyp_widget:
        verlegetyp_widget.currentIndexChanged.connect(update_Darstellung)    
    if aussendurchmesser_widget:
        aussendurchmesser_widget.textChanged.connect(update_Darstellung)            
        
    
    update_Darstellung()          ]]></editforminitcode>
