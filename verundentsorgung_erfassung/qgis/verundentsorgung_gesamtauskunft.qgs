            <editforminitcode><![CDATA[from PyQt5 import uic
from PyQt5.QtWidgets import QDialog

ui_path = r'U:\intern\verundentsorgung_erfassung\qgis\ui\test.ui'

class MeinDialog(QDialog):
    def __init__(self):
        super().__init__()
        uic.loadUi(ui_path, self)
        self.name_number.setText("40095S1000")
        self.button.clicked.connect(self.test)  # <-- Hier verbinden

    def test(self):
        print('button pressed')

dlg = MeinDialog()
dlg.show()
]]></editforminitcode>
