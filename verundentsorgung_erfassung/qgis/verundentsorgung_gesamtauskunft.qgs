                    <labelStyle overrideLabelFont="0" overrideLabelColor="0" labelColor="0,0,0,255,rgb:0,0,0,1">
                      <labelFont strikethrough="0" underline="0" italic="0" description="MS Shell Dlg 2,8.3,-1,5,50,0,0,0,0,0" bold="0" style=""/>
                    </labelStyle>
                  </attributeEditorField>
