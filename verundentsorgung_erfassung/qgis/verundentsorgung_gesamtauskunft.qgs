    <maplayer labelsEnabled="0" wkbType="LineString" geometry="Line" maxScale="0" styleCategories="AllStyleCategories" refreshOnNotifyEnabled="0" hasScaleBasedVisibilityFlag="0" symbologyReferenceScale="-1" simplifyDrawingHints="1" type="vector" readOnly="0" autoRefreshMode="Disabled" minScale="0" simplifyMaxScale="1" autoRefreshTime="0" refreshOnNotifyMessage="" simplifyDrawingTol="1" legendPlaceholderImage="" simplifyAlgorithm="0" simplifyLocal="1">
      <id>Haltung_Kopie_c633351a_2a9c_480d_b4a8_c2ea1518f69d</id>
      <datasource>dbname='gis' host=172.20.1.155 port=5432 authcfg=verent1 key='id' srid=25833 type=LineString checkPrimaryKeyUnicity='0' table="verundentsorgung"."aw_lin_haltung" (geometry) sql=
                exists (
                    select 'X'
                    from verundentsorgung.st_vw_projekt p
                    where p.id = id_st_vw_projekt and p.kurztext = 'ZVG'
                )
                and id_st_strasse in (
                    select s.id_st_strasse
                    from verundentsorgung.strassenschluessel_v s,
                    verundentsorgung.st_vw_projektfilter pf
                    where s.id_st_vw_projekt = pf.id_st_vw_projekt
                    and ( ( position(s.amt in pf.langtext) > 0
                            and pf.kurztext = 'ZVG Projekte Amt Schönberger Land'
                          )
                          or s.amt = 'unbekannt'
                        )
                )
                and 1 = 1
                </datasource>
      <keywordList>
        <value></value>
      </keywordList>
      <layername>Haltung</layername>
