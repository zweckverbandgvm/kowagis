              <defaultAction key="Canvas" value="{4c081adb-a87c-4c14-b6ad-1fce1d7a1a90}"/>
              <actionsetting id="{4c081adb-a87c-4c14-b6ad-1fce1d7a1a90}" notificationMessage="" name="Label erstellen" action="from qgis.utils import iface&#xd;&#xa;from qgis.core import QgsApplication, QgsAuthMethodConfig, Qgis&#xd;&#xa;from qgis.gui import QgsMapToolEmitPoint&#xd;&#xa;from PyQt5.QtWidgets import QDialog, QVBoxLayout, QLabel, QComboBox, QPushButton&#xd;&#xa;from qgis.PyQt.QtCore import Qt&#xd;&#xa;import psycopg2&#xd;&#xa;&#xd;&#xa;# -------------------- Globale Variablen --------------------&#xd;&#xa;vzaehler = None&#xd;&#xa;vid = None&#xd;&#xa;vname_number = None&#xd;&#xa;vtable = None&#xd;&#xa;vlabel_id = None&#xd;&#xa;vpoint1x = None&#xd;&#xa;vpoint1y = None&#xd;&#xa;vpoint2x = None&#xd;&#xa;vpoint2y = None&#xd;&#xa;codes = None&#xd;&#xa;codes2 = None&#xd;&#xa;&#xd;&#xa;auth_mgr = QgsApplication.authManager()&#xd;&#xa;auth_cfg = QgsAuthMethodConfig()&#xd;&#xa;if auth_mgr.loadAuthenticationConfig('[%decode_uri(@layer,'authcfg') %]', auth_cfg, True):&#xd;&#xa;    #iface.messageBar().pushMessage(&quot;Authentication config loaded successfully.&quot;, level=Qgis.Info)  &#xd;&#xa;    config_map = auth_cfg.configMap()&#xd;&#xa;    #iface.messageBar().pushMessage(f&quot;Config Map: {config_map}&quot;, level=Qgis.Info)&#xd;&#xa;    #print(config_map)&#xd;&#xa;    user_pg = config_map.get('username')&#xd;&#xa;    password_pg = config_map.get('password')&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    connection = psycopg2.connect(&#xd;&#xa;    host='[%decode_uri(@layer,'host') %]',&#xd;&#xa;    database='[%decode_uri(@layer,'dbname') %]',&#xd;&#xa;    port='[%decode_uri(@layer,'port') %]',&#xd;&#xa;    user=user_pg,&#xd;&#xa;    password=password_pg&#xd;&#xa;    )&#xd;&#xa;&#xd;&#xa;    cursor = connection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    # Query the data&#xd;&#xa;    query = f&quot;select kurztext, langtext from verundentsorgung.st_vw_label_definition_v where table_name = '[%decode_URI(@layer,'table')%]' &quot;&#xd;&#xa;    cursor.execute(query)&#xd;&#xa;    records = cursor.fetchall()&#xd;&#xa;    print(&quot;Data retrieved from the table:&quot;)&#xd;&#xa;    codes = [row[0] for row in records]&#xd;&#xa;    codes2 = [row[1] for row in records]&#xd;&#xa;&#xd;&#xa;except Exception as error:&#xd;&#xa;    print(&quot;Error while connecting to PostgreSQL:&quot;, error)&#xd;&#xa;finally:&#xd;&#xa;    if connection:&#xd;&#xa;        cursor.close()&#xd;&#xa;        connection.close()&#xd;&#xa;        print(&quot;PostgreSQL connection closed.&quot;)&#xd;&#xa;&#xd;&#xa;canvas = iface.mapCanvas()&#xd;&#xa;&#xd;&#xa;# -------------------- MapTool Klasse --------------------&#xd;&#xa;class PointTool(QgsMapToolEmitPoint):&#xd;&#xa;    def __init__(self, canvas, callback):&#xd;&#xa;        super().__init__(canvas)&#xd;&#xa;        self.canvas = canvas&#xd;&#xa;        self.callback = callback&#xd;&#xa;&#xd;&#xa;    def canvasPressEvent(self, event):&#xd;&#xa;        point = self.toMapCoordinates(event.pos())&#xd;&#xa;        self.callback(point)&#xd;&#xa;&#xd;&#xa;# -------------------- Callback für ersten Klick --------------------&#xd;&#xa;def show_mouse_coords(point):&#xd;&#xa;    global vid, vname_number, vtable, vpoint1x, vpoint1y, vzaehler, pointTool2&#xd;&#xa;    print('Erster Punkt: ({:.4f}, {:.4f})'.format(point.x(), point.y()))&#xd;&#xa;&#xd;&#xa;    if vzaehler is None:&#xd;&#xa;        # Platzhalterwerte (hier ggf. dynamisch ersetzen)&#xd;&#xa;        vname_number = &quot;'[%name_number%]'&quot;&#xd;&#xa;        vid = &quot;'[%id%]'&quot;&#xd;&#xa;        vtable = &quot;'[%decode_uri(@layer,'table')%]'&quot;&#xd;&#xa;        vpoint1x = f&quot;'{point.x():.4f}'&quot;&#xd;&#xa;        vpoint1y = f&quot;'{point.y():.4f}'&quot;&#xd;&#xa;        vzaehler = 1&#xd;&#xa;&#xd;&#xa;        # Setze neues MapTool für zweiten Klick&#xd;&#xa;        pointTool2 = PointTool(canvas, show_mouse_coords2)&#xd;&#xa;        canvas.setMapTool(pointTool2)&#xd;&#xa;&#xd;&#xa;# -------------------- Callback für zweiten Klick --------------------&#xd;&#xa;def show_mouse_coords2(point):&#xd;&#xa;    global vpoint2x, vpoint2y&#xd;&#xa;    print('Zweiter Punkt: ({:.4f}, {:.4f})'.format(point.x(), point.y()))&#xd;&#xa;    vpoint2x = f&quot;'{point.x():.4f}'&quot;&#xd;&#xa;    vpoint2y = f&quot;'{point.y():.4f}'&quot;&#xd;&#xa;    print(vpoint2y)&#xd;&#xa;    &#xd;&#xa;&#xd;&#xa;    print(vid, vname_number, vtable, vlabel_id, vpoint1x, vpoint1y, vpoint2x, vpoint2y)&#xd;&#xa;    verbindung(vid, vname_number, vtable, vlabel_id, vpoint1x, vpoint1y, vpoint2x, vpoint2y)&#xd;&#xa;&#xd;&#xa;# -------------------- PostgreSQL-Verbindung --------------------&#xd;&#xa;def verbindung(vid, vname_number, vtable, vlabel_id, vpoint1x, vpoint1y, vpoint2x, vpoint2y):&#xd;&#xa;    auth_mgr = QgsApplication.authManager()&#xd;&#xa;    auth_cfg = QgsAuthMethodConfig()&#xd;&#xa;    &#xd;&#xa;    if auth_mgr.loadAuthenticationConfig('[%decode_uri(@layer,'authcfg')%]', auth_cfg, True):&#xd;&#xa;        config_map = auth_cfg.configMap()&#xd;&#xa;        user_pg = config_map.get('username')&#xd;&#xa;        password_pg = config_map.get('password')&#xd;&#xa;&#xd;&#xa;        try:&#xd;&#xa;            connection = psycopg2.connect(&#xd;&#xa;                host='[%decode_uri(@layer,'host')%]',&#xd;&#xa;                database='[%decode_uri(@layer,'dbname')%]',&#xd;&#xa;                port='[%decode_uri(@layer,'port')%]',&#xd;&#xa;                user=user_pg,&#xd;&#xa;                password=password_pg&#xd;&#xa;            )&#xd;&#xa;            cursor = connection.cursor()&#xd;&#xa;            query = f&quot;&quot;&quot;&#xd;&#xa;                SELECT verundentsorgung.label_erfassen(&#xd;&#xa;                    {vid}, {vname_number}, {vtable}, {vlabel_id},&#xd;&#xa;                    {vpoint1x}, {vpoint1y}, {vpoint2x}, {vpoint2y}&#xd;&#xa;                )&#xd;&#xa;            &quot;&quot;&quot;&#xd;&#xa;            print(&quot;SQL Query:&quot;, query)&#xd;&#xa;            cursor.execute(query)&#xd;&#xa;            connection.commit()&#xd;&#xa;            results = cursor.fetchall()&#xd;&#xa;            print(&quot;Ergebnisse:&quot;, results)&#xd;&#xa;            iface.messageBar().pushMessage(&quot;Daten geladen.&quot;, level=Qgis.Info)&#xd;&#xa;        except Exception as e:&#xd;&#xa;            print(f&quot;Fehler bei der DB-Abfrage: {e}&quot;)&#xd;&#xa;        finally:&#xd;&#xa;            if cursor:&#xd;&#xa;                cursor.close()&#xd;&#xa;            if connection:&#xd;&#xa;                connection.close()&#xd;&#xa;&#xd;&#xa;            cleanup()&#xd;&#xa;&#xd;&#xa;def cleanup():&#xd;&#xa;    global vzaehler, vpoint1x, vpoint1y, vpoint2x, vpoint2y, pointTool2&#xd;&#xa;&#xd;&#xa;    # Variablen zurücksetzen&#xd;&#xa;    vzaehler = None&#xd;&#xa;    vpoint1x = None&#xd;&#xa;    vpoint1y = None&#xd;&#xa;    vpoint2x = None&#xd;&#xa;    vpoint2y = None&#xd;&#xa;&#xd;&#xa;    print(&quot;Aufräumen abgeschlossen.&quot;)&#xd;&#xa;    iface.mapCanvas().refreshAllLayers()&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fertig&quot;, &quot;Vorgang beendet&quot;, level=Qgis.Success, duration=3)&#xd;&#xa;&#xd;&#xa;    # MapTool deaktivieren (z. B. zurücksetzen auf Auswahlwerkzeug)&#xd;&#xa;    canvas.unsetMapTool(canvas.mapTool())                &#xd;&#xa;&#xd;&#xa;# -------------------- Dialog zur Auswahl --------------------&#xd;&#xa;class ComboDialog(QDialog):&#xd;&#xa;    def __init__(self):&#xd;&#xa;        global codes, codes2&#xd;&#xa;        super().__init__()&#xd;&#xa;        self.setWindowTitle(&quot;Wähle ein Label&quot;)&#xd;&#xa;        self.setMinimumWidth(300)&#xd;&#xa;&#xd;&#xa;        layout = QVBoxLayout()&#xd;&#xa;&#xd;&#xa;        self.label = QLabel(&quot;Bitte ein Label wählen:&quot;)&#xd;&#xa;        layout.addWidget(self.label)&#xd;&#xa;&#xd;&#xa;        self.combo = QComboBox()&#xd;&#xa;        #self.combo.addItems(codes)  # Labels hier definieren&#xd;&#xa;        for code, label in zip(codes, codes2):&#xd;&#xa;            self.combo.addItem(label, code)&#xd;&#xa;        layout.addWidget(self.combo)&#xd;&#xa;&#xd;&#xa;        btn = QPushButton(&quot;Auswahl bestätigen&quot;)&#xd;&#xa;        btn.clicked.connect(self.auswahl_bestaetigen)&#xd;&#xa;        layout.addWidget(btn)&#xd;&#xa;&#xd;&#xa;        self.setLayout(layout)&#xd;&#xa;&#xd;&#xa;    def auswahl_bestaetigen(self):&#xd;&#xa;        global vlabel_id&#xd;&#xa;        #auswahl = self.combo.currentText()&#xd;&#xa;        auswahl = self.combo.currentData()&#xd;&#xa;        vlabel_id = f&quot;'{auswahl}'&quot;&#xd;&#xa;        #print(&quot;Label gewählt:&quot;, vlabel_id)&#xd;&#xa;        for code, label in zip(codes, codes2):&#xd;&#xa;            self.combo.addItem(label, code)&#xd;&#xa;&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Ausgewählt:&quot;, auswahl, level=Qgis.Info, duration=4)&#xd;&#xa;        self.accept()&#xd;&#xa;&#xd;&#xa;        # Starte MapTool&#xd;&#xa;        self.pointTool1 = PointTool(canvas, show_mouse_coords)&#xd;&#xa;        canvas.setMapTool(self.pointTool1)&#xd;&#xa;        print(&quot;Bitte klicken Sie auf den ersten Punkt.&quot;)&#xd;&#xa;&#xd;&#xa;# -------------------- Dialog starten --------------------&#xd;&#xa;dlg = ComboDialog()&#xd;&#xa;dlg.exec_()&#xd;&#xa;" type="1" capture="0" isEnabledOnlyWhenEditable="0" shortTitle="Label erstellen" icon="">
